{
  "manifest_version": 3,
  "name": "LinkedIn Auto-Applier",
  "version": "1.1.3",
  "description": "Intelligent automated job application assistant for LinkedIn with hybrid experience matching, smart filters, and auto-apply.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkedIn Auto-Applier Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "all_frames": true,
      "js": [
        "scripts/fuzzy-matcher.js",
        "scripts/form-filler.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "all_frames": false,
      "js": [
        "scripts/applier.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/default_profile.json",
        "icons/*.png"
      ],
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ]
}
